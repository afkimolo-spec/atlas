# Atlas Environment Template
# Copy to .env only when environment variables are required.
# Never commit the populated .env file.

# Atlas
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO

# Workspace
ATLAS_ROOT=/home/administrator/workspace/atlas

# Database
ATLAS_DATABASE=/home/administrator/workspace/atlas/.ai/memory/db/atlas.db

# Model endpoints
ATLAS_EMBEDDING_URL=http://localhost:8000/v1
ATLAS_COMPLETION_URL=http://localhost:8001/v1
ATLAS_AGENT_URL=http://localhost:8002/v1
ATLAS_RESEARCH_URL=http://localhost:8003/v1

# Model paths
ATLAS_MODEL_DIR=/opt/models

# Optional external API credentials
# OPENAI_API_KEY=replace-with-real-value
# GITHUB_TOKEN=replace-with-real-value
